{
    "name": "charm/exception-middleware",
    "description": "Provides a PSR-15 Middleware which traps exceptions and renders a nice error page.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Charm\\Middleware\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "charm/interop": "^0.0.2",
        "charm/error": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
